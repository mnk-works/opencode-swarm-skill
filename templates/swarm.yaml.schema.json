{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCode Swarm Configuration",
  "type": "object",
  "required": ["coordination_mode", "context_ttl", "agents"],
  "properties": {
    "coordination_mode": {
      "type": "string",
      "enum": ["peer_collaboration", "pipeline", "consensus", "delegation"],
      "description": "How agents coordinate"
    },
    "context_ttl": {
      "type": "string",
      "enum": ["session", "persistent"],
      "description": "How long shared context persists"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "model", "role"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Unique agent identifier (lowercase, hyphens)"
          },
          "model": {
            "type": "string",
            "description": "OpenCode model ID (provider/model#variant)"
          },
          "role": {
            "type": "string",
            "description": "Human-readable role description"
          },
          "system_prompt": {
            "type": "string",
            "description": "Full system prompt for this agent"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "host": { "type": "string", "default": "localhost" },
        "port": { "type": "integer", "default": 0, "description": "0 = random port" }
      }
    },
    "human": {
      "type": "object",
      "properties": {
        "approve_on": {
          "type": "array",
          "items": { "type": "string", "enum": ["task_completion", "final_output", "vote_proposal", "escalation"] }
        },
        "notification": { "type": "string", "enum": ["terminal", "file", "webhook"], "default": "terminal" }
      }
    }
  }
}